{
  "name": "pni-scheduler",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-28",
  "workers_dev": false,
  "preview_urls": false,
  "vars": { "PNI_DISPATCH_TARGET": "production" },
  "triggers": { "crons": ["30 22 * * *", "30 11 * * *"] },
  "observability": { "enabled": true, "head_sampling_rate": 1 }
}
